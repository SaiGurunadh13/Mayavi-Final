# Mayavi Backend Environment Configuration Template
# Copy to .env for local overrides (never commit real production passwords or tokens)

# Environment Mode: 'development' or 'production' (or 'prod', 'live')
ENVIRONMENT=development

# Production API Documentation (default false in production, true in development)
ENABLE_DOCS=false

# Media Security: SVG uploads are disabled by default for stored-XSS protection
ALLOW_SVG_UPLOADS=false

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Allowed Origins for CORS (comma-separated list of frontends)
CORS_ORIGINS=https://klmayavi.in,https://www.klmayavi.in,http://localhost:8000,http://127.0.0.1:8000

# Cookies
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax

# Storage paths (set to persistent mount path on Render, e.g. /var/data/data)
DATA_DIR=data
UPLOADS_DIR=uploads

# Initial Administrator Credentials (mandatory in production when database is empty)
# Must be at least 12 characters with uppercase, lowercase, number, and special character.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@mayavi.tech
ADMIN_PASSWORD=SetAStrongPasswordHere2026!
